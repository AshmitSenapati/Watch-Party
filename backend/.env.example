# ====================================================
# Watch Party - Backend Environment Configuration
# ====================================================

# Port for the HTTP and WebSocket server (Render assigns this automatically via $PORT)
PORT=5000

# Server host binding (use 0.0.0.0 for container / cloud hosting like Render)
HOST=0.0.0.0

# Allowed frontend origins for CORS (comma-separated list)
# Always set to your deployed Vercel domain(s). Wildcard subdomains like https://*.vercel.app
# are supported to allow both production and git preview deployments automatically.
# Local development origins (localhost:5173, etc.) are always allowed automatically as fallbacks.
CLIENT_URL=https://your-watch-party.vercel.app
ALLOWED_ORIGINS=https://your-watch-party.vercel.app,https://*.vercel.app,http://localhost:5173

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster-domain>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/watchparty?retryWrites=true&w=majority
